{
  "mcpServers": {
    "reweigh": {
      "command": "uv",
      "args": ["--directory", ".", "run", "--locked", "--no-project", "--no-config", "--script", "./scripts/bridge.py",
               "--peer", "claude"],
      "cwd": ".",
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 4200,
      "env_vars": ["REWEIGH_ACTIVE", "REWEIGH_THREADS", "REWEIGH_TIMEOUT_SECONDS", "REWEIGH_STATE_DIR",
                   "REWEIGH_CLAUDE_BIN", "REWEIGH_SUBAGENTS", "REWEIGH_CLAUDE_MODEL",
                   "REWEIGH_CLAUDE_REASONING_EFFORT", "XDG_STATE_HOME", "CLAUDE_CONFIG_DIR"]
    }
  }
}
